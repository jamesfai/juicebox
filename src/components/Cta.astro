---
import Deco from './Deco.astro';
---

<section class="sec cta" id="contact">
  <div class="wrap cta-card rv">
    <Deco n="05" style="--w:clamp(130px,17vw,300px);--r:-8deg;right:1%;bottom:-8%;--t:12s" />
    <div class="cta-copy">
      <p class="kicker">Your Move</p>
      <h2 class="h2">Let's Get Your Brand Moving.</h2>
      <p class="lede">A short chat about your goals, your audience and where you want to go.</p>
      <div class="cta-row">
        <a class="btn btn-primary" href="https://juicebox.ph/contact-us/">Book a Discovery Call</a>
        <a class="btn btn-ghost" href="mailto:hello@juicebox.ph">hello@juicebox.ph</a>
      </div>
    </div>
  </div>
</section>
